VITE_AI_PROVIDER=qwen
VITE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
VITE_AI_MODEL_NAME=gemini-1.5-flash
VITE_AI_TIMEOUT_MS=15000
VITE_AI_TEMPERATURE=0.4

QWEN_API_KEY=
QWEN_API_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_TIMEOUT_SECONDS=30

# Endpoint del backend de telemetría desplegado en Dokploy
VITE_TELEMETRY_API_URL=https://api-telemetry.tudominio.com/api/v1
VITE_API_URL=https://api-telemetry.tudominio.com/api/v1
VITE_RESEARCH_CONDITION=standard

# Orquestación local / Dokploy
PORT=8000
FRONTEND_PORT=8080
DASHBOARD_PORT=8081
POSTGRES_USER=tivot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tivot_db
DATABASE_URL=postgresql+asyncpg://tivot:change-me@postgres:5432/tivot_db
CORS_ORIGINS=http://localhost:8080,http://localhost:8081
ADMIN_API_KEY=change-me
# Si se habilita, usa el mismo valor en TELEMETRY_CLIENT_KEY y VITE_TELEMETRY_CLIENT_KEY.
TELEMETRY_CLIENT_KEY=
RESEARCHER_PASSWORD=change-me
JWT_SECRET_KEY=change-me

# Identificador del entorno (development / production)
VITE_APP_ENV=production

# Clave opcional para validar la ingesta (debe coincidir con TELEMETRY_CLIENT_KEY)
VITE_TELEMETRY_CLIENT_KEY=
